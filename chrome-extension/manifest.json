{
  "manifest_version": 3,
  "name": "LinkedIn Post Scraper",
  "version": "1.0.3",
  "description": "Scrape LinkedIn posts by keyword and location. For educational use only.",

  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "tabs",
    "storage",
    "sidePanel"
  ],

  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://api.openai.com/*"
  ],

  "side_panel": {
    "default_path": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "LinkedIn Post Scraper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/search/results/content/*"],
      "js": ["main_world_interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.linkedin.com/search/results/content/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

