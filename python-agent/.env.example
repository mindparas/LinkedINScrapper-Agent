# ==============================================================================
# Environment Configuration Template for LinkedIn BDE Lead Discovery Agent
# ==============================================================================
# Copy this file to .env and insert your real credentials:
#   cp .env.example .env
# Never commit .env. Put one KEY=value per line.

# ── LLM provider ──────────────────────────────────────────────────────────────
# Which provider runs the judge, the agent loop and the intent interpreter:
#   anthropic | openai
# If unset: anthropic when ANTHROPIC_API_KEY is present, otherwise openai.
LLM_PROVIDER=anthropic

# Anthropic (Claude) API key - needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# OpenAI API key - needed when LLM_PROVIDER=openai. Either variable name works:
OPENAI_API_KEY=sk-your-openai-api-key-here
gpt-apikey=sk-your-openai-api-key-here

# ── Optional: model per role ──────────────────────────────────────────────────
# Defaults: claude-sonnet-5-5 (anthropic) / gpt-4o-mini (openai).
# Cheaper agent loop example: LLM_MODEL_AGENT=claude-haiku-5-5
# LLM_MODEL_JUDGE=claude-sonnet-5-5
# LLM_MODEL_AGENT=claude-sonnet-5-5
# LLM_MODEL_INTERPRETER=claude-sonnet-5-5
# (LEAD_JUDGE_MODEL is still accepted as an alias for LLM_MODEL_JUDGE.)

# ── Optional: query learning ──────────────────────────────────────────────────
# QUERY_ENGINE=on                 # off = fixed query lists only (no strategist / learner)
# QUERY_STAGNATION_LIMIT=9        # stop early after this many queries in a row match nothing (0 = never)

# ── Optional: LinkedIn safety limits per day ──────────────────────────────────
# These two are read from the shell environment only (not from this file), e.g.:
#   BDE_MAX_SEARCHES_PER_DAY=75 BDE_MAX_PROFILE_VISITS_PER_DAY=60 ./run_leads.sh -n 3

# Optional: Google Gemini API Key (if using Gemini workflows)
gemini-api-key=your-gemini-api-key-here
